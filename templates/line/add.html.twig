{% extends 'base.html.twig' %}

{% block title %}Ajouter une ligne de métro{% endblock %}

{% block body %}
    {% for message in app.flashes('danger')%}
        <div class="alert alert-danger text-center">
        {{ message }}
    </div>
    {% endfor %}
    <div class="container mt-5 d-flex flex-column align-items-center">
        <div class="text-center">
            <div class="card-header text-center">
                <h1 class="mb-4">Ajout d'une ligne de métro</h1>
            </div>
            <div class="card-body d-flex flex-column justify-content-center align-items-center text-center w-75 mx-auto">
                <p>
                    Veuillez télécharger un fichier JSON contenant les données de la ligne de métro.
                    Assurez-vous que le fichier respecte le format requis.
                    Vous pouvez également de vous même ajouter une ligne station par station
                </p>
                <a href="{{path('ferrovipath_add_manually')}}" class="btn btn-outline-success mb-3">
                    Ajouter manuellement une autre ligne
                </a>
                <a href="{{ asset('jsonFile/exempleLigne.json') }}" download class="btn btn-outline-secondary mb-3">
                    Télécharger un exemple de fichier JSON
                </a>
                <div class="mb-3">
                    <a href="{{path('ferrovipath_add_manually')}}" class="btn btn-outline-info">Voir la liste des lignes existantes</a>
                </div>
                {{ form_start(addLineForm) }}
                <div class="mb-3">
                    <i class="fas fa-file-upload"></i>
                    {{ form_row(addLineForm.lineFile) }}
                </div>
                <div class="mb-3">
                    {{ form_row(addLineForm.saveButton) }}
                </div>
                {{ form_end(addLineForm) }}
            
            </div>
        </div>            
    </div>

{% endblock %}