{% extends 'base.html.twig' %}

{% block title %} Maps {% endblock %}

{% block body %} 
<div class="container my-5">
    <section class="text-center mb-5">    
        <h1>Lignes - réponses</h1>
        <p>Sélectionnez la lignes que dont vous souhaitez visualiser les réponses</p>
    </section>

    <section class="row text-center mb-5">
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="card-title">
                        <form method="GET" action="{{ path('ferrovipath_answer') }}">
                            <select name="line" class="form-select" onchange="this.form.submit()">
                                <option selected disabled>Choisissez la ligne à visualiser</option>
                                <option value="metro1" {% if imagePath == '/img/Ligne1Answer.png' %}selected{% endif %}>Métro 1</option>
                                <option value="metro2" {% if imagePath == '/img/Ligne2Answer.png' %}selected{% endif %}>Métro 2</option>
                                <option value="metro3" {% if imagePath == '/img/Ligne3Answer.png' %}selected{% endif %}>Métro 3</option>
                                <option value="metro4" {% if imagePath == '/img/Ligne4Answer.png' %}selected{% endif %}>Métro 4</option>
                                <option value="metro5" {% if imagePath == '/img/Ligne5Answer.png' %}selected{% endif %}>Métro 5</option>
                                <option value="metro6" {% if imagePath == '/img/Ligne6Answer.png' %}selected{% endif %}>Métro 6</option>
                                <option value="metro7" {% if imagePath == '/img/Ligne7Answer.png' %}selected{% endif %}>Métro 7</option>
                                <option value="metro8" {% if imagePath == '/img/Ligne8Answer.png' %}selected{% endif %}>Métro 8</option>
                                <option value="metro9" {% if imagePath == '/img/Ligne9Answer.png' %}selected{% endif %}>Métro 9</option>
                                <option value="metro10" {% if imagePath == '/img/Ligne10Answer.png' %}selected{% endif %}>Métro 10</option>
                                <option value="metro11" {% if imagePath == '/img/Ligne11Answer.png' %}selected{% endif %}>Métro 11</option>
                                <option value="metro12" {% if imagePath == '/img/Ligne12Answer.png' %}selected{% endif %}>Métro 12</option>
                                <option value="metro13" {% if imagePath == '/img/Ligne13Answer.png' %}selected{% endif %}>Métro 13</option>
                                <option value="metro14" {% if imagePath == '/img/Ligne14Answer.png' %}selected{% endif %}>Métro 14</option>
                                <option value="metro15" {% if imagePath == '/img/Ligne15Answer.png' %}selected{% endif %}>Métro 15</option>
                                <option value="metro16" {% if imagePath == '/img/Ligne16Answer.png' %}selected{% endif %}>Métro 16</option>
                                <option value="metro17" {% if imagePath == '/img/Ligne17Answer.png' %}selected{% endif %}>Métro 17</option>
                                <option value="metro18" {% if imagePath == '/img/Ligne18Answer.png' %}selected{% endif %}>Métro 18</option>
                                <option value="metro19" {% if imagePath == '/img/Ligne19Answer.png' %}selected{% endif %}>Métro 19</option>
                            </select>
                        </form>
                    </div>
                </div>
            </div>
        </div>
        <div class = "image">
            <img src="{{ asset(imagePath) }}" alt="Image de la ligne" class="logo
            {% if imagePath == '/img/Ligne1Answer.png' %}m1{% endif %}
            {% if imagePath == '/img/Ligne2Answer.png' %}m2{% endif %}
            {% if imagePath == '/img/Ligne3Answer.png' %}m1{% endif %}
            {% if imagePath == '/img/Ligne4Answer.png' %}m2{% endif %}
            {% if imagePath == '/img/Ligne5Answer.png' %}m1{% endif %}
            {% if imagePath == '/img/Ligne6Answer.png' %}m2{% endif %}
            {% if imagePath == '/img/Ligne7Answer.png' %}m1{% endif %}
            {% if imagePath == '/img/Ligne8Answer.png' %}m2{% endif %}
            {% if imagePath == '/img/Ligne9Answer.png' %}m1{% endif %}
            {% if imagePath == '/img/Ligne10Answer.png' %}m2{% endif %}
            {% if imagePath == '/img/Ligne11Answer.png' %}m1{% endif %}
            {% if imagePath == '/img/Ligne12Answer.png' %}m2{% endif %}
            {% if imagePath == '/img/Ligne13Answer.png' %}m1{% endif %}
            {% if imagePath == '/img/Ligne14Answer.png' %}m2{% endif %}
            {% if imagePath == '/img/Ligne15Answer.png' %}m1{% endif %}
            {% if imagePath == '/img/Ligne16Answer.png' %}m2{% endif %}
            {% if imagePath == '/img/Ligne17Answer.png' %}m1{% endif %}
            {% if imagePath == '/img/Ligne18Answer.png' %}m2{% endif %}
            {% if imagePath == '/img/Ligne19Answer.png' %}m1{% endif %}">
        </div>
    </section>  
</div>

<style>
  .card-body {
    background-color:#FCF9ED; 
  }
  .form-select {
    background-color: rgb(255, 255, 255);
    border-color:rgb(8, 13, 17);  

  }
  .image img.m1{
    width: 100%; /* Pour que l'image prenne toute la largeur du conteneur */
    max-width: 1000px; /* Par exemple, pour limiter la largeur de l'image à 500px */
    height: auto; /* Garde la proportion de l'image */
    margin-top: 20px; /* Optionnel, pour ajouter un peu d'espace au-dessus de l'image */
  }
  .image img.m2{
    width: 1100px; /* Pour que l'image prenne toute la largeur du conteneur */
    height: auto; /* Garde la proportion de l'image */
    margin-top: 20px; /* Optionnel, pour ajouter un peu d'espace au-dessus de l'image */
  }
</style>
{% endblock %}