{% extends 'base.html.twig' %}

{% block title %} Maps {% endblock %}

{% block body %} 
<div class="container my-5">
    <section class="text-center mb-5">    
        <h1>Lignes - réponses</h1>
        <p>Sélectionnez la lignes que dont vous souhaitez visualiser les réponses</p>
    </section>

    <section class="row text-center mb-5">
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="card-title">
                        <form method="GET" action="{{ path('ferrovipath_answer') }}">
                            <select name="line" class="form-select" onchange="this.form.submit()">
                                <option selected disabled>Choisissez la ligne à visualiser</option>
                                <option value="metro1" {% if imagePath == '/img/m1.webp' %}selected{% endif %}>Métro 1</option>
                                <option value="metro2" {% if imagePath == '/img/m2.webp' %}selected{% endif %}>Métro 2</option>
                                <option value="metro3" {% if imagePath == '/img/m3.webp' %}selected{% endif %}>Métro 3</option>
                            </select>
                        </form>
                    </div>
                </div>
            </div>
        </div>
        <div class = "image">
            <img src="{{ asset(imagePath) }}" alt="Image de la ligne" class="logo
            {% if imagePath == '/img/m1.webp' %}m1{% endif %}
                {% if imagePath == '/img/m2.webp' %}m2{% endif %}
                {% if imagePath == '/img/m3.webp' %}m3{% endif %}">
        </div>
    </section>  
</div>

<style>
  .card-body {
    background-color:#FCF9ED; 
  }
  .form-select {
    background-color: rgb(255, 255, 255);
    border-color:rgb(8, 13, 17);  

  }
  .image img.m1{
    width: 100%; /* Pour que l'image prenne toute la largeur du conteneur */
    max-width: 1000px; /* Par exemple, pour limiter la largeur de l'image à 500px */
    height: auto; /* Garde la proportion de l'image */
    margin-top: 20px; /* Optionnel, pour ajouter un peu d'espace au-dessus de l'image */
  }
  .image img.m2{
    width: 1100px; /* Pour que l'image prenne toute la largeur du conteneur */
    height: auto; /* Garde la proportion de l'image */
    margin-top: 20px; /* Optionnel, pour ajouter un peu d'espace au-dessus de l'image */
  }
</style>
{% endblock %}