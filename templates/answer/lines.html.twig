{% extends 'base.html.twig' %}

{% block title %} Maps {% endblock %}

{% block body %} 
<div class="container my-5">
    <section class="text-center mb-5">    
        <h1>Lignes - réponses</h1>
    </section>

    <section class="row text-center mb-5">
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="card-title">
                        <form method="GET" action="{{ path('ferrovipath_answer') }}">
                            <select name="line" class="form-select" onchange="this.form.submit()">
                                <option selected disabled>Choisissez la ligne à visualiser</option>
                                <option value="metro1" {% if imagePath == '/img/m1.png' %}selected{% endif %}>Métro 1</option>
                                <option value="metro2" {% if imagePath == '/img/metro2.png' %}selected{% endif %}>Métro 2</option>
                                <option value="metro3" {% if imagePath == '/img/metro3.png' %}selected{% endif %}>Métro 3</option>
                            </select>
                        </form>
                    </div>
                </div>
            </div>
        </div>
        <div class = "image">
            <img src="{{ asset(imagePath) }}" alt="Image de la ligne" class="logo">
        </div>
    </section>  
</div>

{% endblock %}