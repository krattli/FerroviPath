{% extends 'base.html.twig' %}


<!--  Fichier obsolète, cette page de jeu n'est tout simplement plus utilisée, UI trop moche  -->


{% block title %}Jeu{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/games.css') }}">
{% endblock %}

{% block body %}
    <body>
    <div class="container">
        <div class="left-column">
            <div class="completion-block">
                <div class="completion-title">Completion</div>
                <div class="completion-content">
                    <div class="completion-line">
                        <span class="field-name">Temps :</span>
                        <span class="field-value" data-field="time">00:00</span>
                    </div>
                    <div class="completion-line">
                        <span class="field-name">Lignes :</span>
                        <span class="field-value" data-field="lines">0/{{ line.getStations()|length }}</span>
                    </div>
                    <div class="completion-line">
                        <span class="field-name">Score :</span>
                        <span class="field-value" data-field="score">0</span>
                    </div>
                </div>
            </div>

            <div class="completion-block">
                <div class="completion-title">Entrer une station</div>
                <div class="completion-content">
                    <div class="completion-line">
                        <span class="field-name">Station :</span>
                        <label>
                            <input type="text"
                                   class="custom-input"
                                   data-input="station"
                                   placeholder="Nom de la station">
                        </label>
                    </div>
                    <div class="completion-line">
                        <span class="field-name">Correspondance :</span>
                        <label>
                            <input type="text" class="custom-input">
                        </label>
                    </div>
                </div>
            </div>
        </div>

        <div class="right-column">
            <div class="instruction-block">
                <h2>Ferrovipath - (Jeu)</h2>
                <p><strong>Consigne :</strong> Compléter toutes les stations de la ligne {{ line.getNameLine() }} du métro de Paris</p>
            </div>

            <div class="game-area" data-game-area
                 data-stations="{{ line.getStations()|map(station => station.getNameStation()|lower)|join(',') }}"
                 data-color="{{ line.getColor() }}"
                 data-symbol="{{ line.getSymbol() }}"
                 data-line-id="{{ line.getIdLine() }}"
                 data-user-id="{{ app.user ? app.user.getIdUser() : 'anonymous' }}"
                {% if game is defined %}
                     data-game-id="{{ game.idGame }}"
                     data-resume="true"
                     data-discovered="{{ game.completedStations|join(',') }}"
                     data-time="{{ game.time }}"

                {% else %}
                     data-resume="false"
                     data-discovered=""
                {% endif %}>

            <!-- la dernière ligne sers à faire en sorte qu'on ai pas besoin de se connecter pour jouer, les scores seront sauvegardables en anonymes même-->
            </div>

            <div class="button-container">
                <a href= "{{ path('ferrovipath_homepage') }}" id= "abandon-button" class="btn game-button" onclick="return confirmAbandon('Etes-vous sûr d\'abandonner ? La partie ne sera pas sauvegardé.')">Abandonner</a>
                <a href= "{{ path('ferrovipath_game',  {'id': line.idLine } )}}" class="game-button">Rejouer</a>
                <button class="game-button" id="saveAndQuitBtn">Sauvegarder et quitter</button>
            </div>
        </div>
    </div>
    </body>
    <!-- On fait un popup personnalisé pour sauvegarder et quitter, le popup par défault du navigateur est moche -->
    <div id="customConfirm" class="custom-confirm hidden">
        <div class="custom-confirm-content">
            <p>Voulez-vous sauvegarder et quitter cette partie ?</p>
            <button id="confirmYesBtn">Oui</button>
            <button id="confirmNoBtn">Non</button>
        </div>
    </div>
    <style>
        .custom-confirm {
            position: fixed;
            top: 0; left: 0;
            width: 100%; height: 100%;
            background-color: rgba(0,0,0,0.5);
            z-index: 9999;
            display: flex;
            justify-content: center;
            align-items: center;
        }
        .custom-confirm.hidden {
            display: none;
        }
        .custom-confirm-content {
            background-color: #fff;
            padding: 20px;
            border-radius: 10px;
            text-align: center;
        }
        .custom-confirm-content button {
            margin: 0 10px;
        }
    </style>
    <script src="{{ asset('js/metroGame.js') }}"></script>
{% endblock %}

