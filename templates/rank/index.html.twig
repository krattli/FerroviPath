{% extends 'base.html.twig' %}

{% block title %} Ferrovipath - Classement {% endblock %}

{% block body %}
    <div class="container mt-4">
        <h2 class="mb-4 custom-title">
            <i class="fas fa-list" aria-hidden="true"></i> Classement par ligne
        </h2>

        <form method="get" action="{{ path('ferrovipath_rank') }}" class="mb-4">
            <label for="line">Choisissez une ligne :</label>
            <select name="line" id="line" class="form-select w-auto d-inline-block mx-2">
                <option value="">-- Choisir une ligne --</option>
                {% for line in lines %}
                    <option value="{{ line.idLine }}" {% if selectedLineId == line.idLine %}selected{% endif %}>
                        {{ line.nameLine }}
                    </option>
                {% endfor %}
            </select>
            <button type="submit" class="btn btn-primary">Voir les parties</button>
        </form>

        {% if games is empty %}
            <p class="alert alert-warning">Aucune partie trouvée pour cette ligne.</p>
        {% else %}
            <div class="table-container">
                <table class="table table-bordered table-hover">
                    <thead class="table-header">
                    <tr>
                        <th>Rang</th>
                        <th>Pseudo</th>
                        <th>Score</th>
                        <th>Temps (s)</th>
                        <th>Date</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for game in games %}
                        <tr>
                            <td>{{ loop.index }}</td>
                            <td>{{ game.user.pseudo }}</td>
                            <td>{{ game.scorePoints }}</td>
                            <td>
                                {% set minutes = game.time // 60 %}
                                {% set seconds = game.time % 60 %}
                                {{ '%02d:%02d'|format(minutes, seconds) }}
                            </td>
                            <td>{{ game.createdAt|date('d/m/Y H:i') }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>

    <style>
        .custom-title {
            color: #8B5E3C;
            font-family: Parisine, sans-serif;
            font-size: 2.5rem;
            font-weight: bold;
        }

        .table-container {
            width: 90%;
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px 0;
        }

        .table-header {
            background-color: #C2B280;
            color: white;
        }

        .table {
            width: 100%;
            border-spacing: 0;
        }

        .table-bordered th, .table-bordered td {
            padding: 10px;
            text-align: center;
        }
    </style>

{% endblock %}
