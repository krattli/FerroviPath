{% extends 'base.html.twig' %}

{% block title %} Ferrovipath - Classement {% endblock %}

{% block body %}
    <div class="container mt-4">
        <h2 class="mb-4">
            <i class="fas fa-list" aria-hidden="true"></i> Classement par ligne
        </h2>

        <form method="get" action="{{ path('ferrovipath_rank') }}" class="mb-4">
            <label for="line">Choisissez une ligne :</label>
            <select name="line" id="line" class="form-select w-auto d-inline-block mx-2">
                <option value="">-- Choisir une ligne --</option>
                {% for line in lines %}
                    <option value="{{ line.idLine }}" {% if selectedLineId == line.idLine %}selected{% endif %}>
                        {{ line.nameLine }}
                    </option>
                {% endfor %}
            </select>
            <button type="submit" class="btn btn-primary">Voir les parties</button>
        </form>

        {% if games is empty %}
            <p class="alert alert-warning">Aucune partie trouvée pour cette ligne.</p>
        {% else %}
            <table class="table table-bordered table-hover table-striped">
                <thead class="table-dark">
                <tr>
                    <th>#</th>
                    <th>Pseudo</th>
                    <th>Score</th>
                    <th>Temps (s)</th>
                    <th>Date</th>
                </tr>
                </thead>
                <tbody>
                {% for game in games %}
                    <tr>
                        <td>{{ loop.index }}</td>
                        <td>{{ game.user.pseudo }}</td>
                        <td>{{ game.scorePoints }}</td>
                        <td>{{ game.time }}</td>
                        <td>{{ game.createdAt|date('d/m/Y H:i') }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>
{% endblock %}
