{% extends 'base.html.twig' %}

{% block title %}Classement{% endblock %}

{% block body %}
<h1>Classement des joueurs</h1>
<table>
    <thead>
        <tr>
            <th>#</th>
            <th>Pseudo</th>
            <th>Score total</th>
        </tr>
    </thead>
    <tbody>
        {% for joueur in joueurs %}
            <tr>
                <td>{{ loop.index }}</td>
                <td>{{ joueur.pseudo }}</td>
                <td>{{ joueur.totalScore }}</td>
            </tr>
        {% endfor %}
    </tbody>
</table>
{% endblock %}
