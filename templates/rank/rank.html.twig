<h2>Classement par ligne</h2>

<form method="get" action="{{ path('ferrovipath_rank') }}" class="mb-4">
    <label for="line">Choisissez une ligne :</label>
    <select name="line" id="line" class="form-select w-auto d-inline-block">
        <option value="">-- Choisir une ligne --</option>
        {% for line in lines %}
            <option value="{{ line.idLine }}" {% if selectedLineId == line.idLine %}selected{% endif %}>
                {{ line.name }}
            </option>
        {% endfor %}
    </select>
    <button type="submit" class="btn btn-primary">Voir classement</button>
</form>

{% if joueurs is empty %}
    <p class="alert alert-warning">Aucun score trouvé pour cette ligne.</p>
{% else %}
    <table class="table table-bordered table-hover">
        <thead>
        <tr>
            <th>Position</th>
            <th>Pseudo</th>
            <th>Score total</th>
        </tr>
        </thead>
        <tbody>
        {% for joueur in joueurs %}
            <tr>
                <td>{{ loop.index }}</td>
                <td>{{ joueur.pseudo }}</td>
                <td>{{ joueur.totalScore }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endif %}
