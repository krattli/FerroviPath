{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block body %} 
{% for message in app.flashes('successRegistration') %}
    <div class="alert alert-success text-center">
        {{ message }}
    </div>
{% endfor %}

    <div class="container my-5 d-flex flex-column align-items-center">
        <h1>Bienvenue sur Ferrovipath</h1>
        <section class="text-center border p-3 custom-box">    
            <p>
                FerroviPath est site web qui propose un jeu intéractive de mémoire dont le but est de reconstituer un réseau de transport associé à une ville avec toutes ses lignes, ses stations et ses correspondances.
                Plusieurs modes de jeu seront disponibles (carte vide, carte avec les lignes de stations déjà placées, trouver un itinéraire selon une station de départ et une station d’arrivée).
            </p>
        </section>
    </div>
    
    <section class="row text-center mb-5">
    <h2>Découvrez notre site!</h2>
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="card-title">
                        <a href="{{ path('ferrovipath_answer') }}" class="btn btn-outline-primary"> 
                            Lignes
                        </a>
                    </div>
                    <p>Voir les solutions </p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="card-title">
                        <button
                                type="button"
                                class="btn btn-outline-primary"
                                data-bs-toggle="modal"
                                data-bs-target="#lineSelectionModal"
                        >
                            Jouer
                        </button>
                    </div>
                    <p>Jouer aux jeux</p>
                </div>
            </div>
        </div>


        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="card-title">
                        <a href="{{ path('ferrovipath_rank') }}" class="btn btn-outline-primary"> <!--A corriger-->
                            Classement
                        </a>
                    </div>
                    <p>Visualiser le classement des meilleures parties </p>
                </div>
            </div>
        </div>

    </section>


    
<section class="row justify-content-md-center text-center mb-5">

{% if not app.user %}
    <p> Première fois sur notre site ? <a href="{{ path('ferrovipath_register') }}" class="link-primary">Inscrivez-vous</a></p>
    <p>Reprendre une partie ? Commencer une nouvelle ? <a href="{{ path('ferrovipath_login') }}" class="link-primary">Identifiez-vous</a></p>
{% endif %}

<div class="col-md-4">
    <div class="card shadow-sm">
        <div class="card-body">
            <div class="card-title">
                <a href="{{ path('ferrovipath_rank') }}" class="btn btn-outline-primary"> <!--A corriger-->
                    Historique
                </a>
            </div>
            <p>Visualiser l'ensemble de vos parties</p>
        </div>
    </div>
</div>
</section>

    <div class="modal fade" id="lineSelectionModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Choisir une ligne</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <label for="lineSelector"></label><select class="form-select" id="lineSelector">
                        <option value="" selected disabled>Sélectionnez une ligne</option>
                        {% if lines is empty %}
                            <option value="0" >Ligne de test</option>
                        {% endif %}
                        {% for line in lines %}
                            <option value="{{ line.getIdLine() }}">{{ line.getNameLine() }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="modal-footer">
                    <button
                            type="button"
                            class="btn btn-primary"
                            id="startGameBtn"
                            disabled
                    >
                        Play
                    </button>
                </div>
            </div>
        </div>
    </div>

<style>
    .custom-box {
        width: 66.66%;
        border: 2px solid black; 
        border-radius: 10px; 
        background-color:rgb(244, 226, 91); 
    }
</style>

<script>
    // Activation du bouton Play quand une ligne est sélectionnée
    document.getElementById('lineSelector').addEventListener('change', function() {
        document.getElementById('startGameBtn').disabled = !this.value;
    });

    // Redirection vers la page du jeu avec la ligne sélectionnée
    document.getElementById('startGameBtn').addEventListener('click', function() {
        const selectedLineId = document.getElementById('lineSelector').value;
        if (selectedLineId) {
            window.location.href = `/game/${selectedLineId}`;
        }
    });
</script>

{% endblock %}