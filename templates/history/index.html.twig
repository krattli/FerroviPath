{% extends 'base.html.twig' %}

{% block title %}Mon Historique{% endblock %}

{% block body %}
    <h2>Historique de vos parties</h2>

    {% if games is empty %}
        <p class="alert alert-info">Vous n'avez encore joué à aucune partie.</p>
    {% else %}
        <table class="table table-bordered">
            <thead>
            <tr>
                <th>Ligne</th>
                <th>Score</th>
                <th>Temps (s)</th>
                <th>date</th>
            </tr>
            </thead>
            <tbody>
            {% for game in games %}
                <tr>
                    <td>{{ game.line.getNameLine }}</td>
                    <td>{{ game.scorePoints }}</td>
                    <td>{{ game.time }}</td>
                    <td>{{ game.createdAt|date('d/m/Y H:i') }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    {% endif %}
{% endblock %}
