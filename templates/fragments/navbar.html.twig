<div class="modal fade" id="lineSelectionModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Choisissez une option</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <ul class="nav nav-tabs mb-3" id="gameTab" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="new-tab" data-bs-toggle="tab" data-bs-target="#newGameTab" type="button" role="tab">Nouvelle partie</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="saved-tab" data-bs-toggle="tab" data-bs-target="#savedGameTab" type="button" role="tab">Reprendre partie</button>
                    </li>
                </ul>
                <div class="tab-content" id="gameTabContent">
                    <!-- faire une nouvelle partie à partir d'une ligne -->
                    <div class="tab-pane fade show active" id="newGameTab" role="tabpanel">
                        <div class="lines-container">
                            {% for line in global_services.getLines() %}
                                <div class="line-item">
                                    <input type="radio" name="lineSelector" id="line-{{ line.getIdLine() }}" value="{{ line.getIdLine() }}" class="line-radio" data-color="{{ line.getColor() }}">
                                    <label for="line-{{ line.getIdLine() }}" class="line-Symbol" style="background-color: {{ line.getColor() }}">
                                        <p style="margin: auto">{{ line.getSymbol() }}</p>
                                    </label>
                                </div>
                            {% endfor %}
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-primary" id="startSelectedGameBtn" disabled>Jouer</button>
                        </div>
                    </div>
                    <!-- reprendre une partie déjà sauvegardée -->
                    {% if app.user is not null %}
                        <div class="tab-pane fade" id="savedGameTab" role="tabpanel">
                            {% if global_services.getGames(app.user.getIdUser) is not empty %}
                                <label for="gameSelector">Parties sauvegardées</label>
                                <div class="saved-games-container">
                                    <style>
                                        /*  On peux faire ça dans twig ??? Incroyable  */
                                        {% for game in global_services.getGames(app.user.getIdUser) %}
                                        .game-hover-{{ game.idGame }}:hover .savedGame-fill {
                                            background-color: {{ game.line.getColor() }};
                                            width: 100%;
                                        }
                                        {% endfor %}
                                    </style>

                                    {% for game in global_services.getGames(app.user.getIdUser) %}
                                        {% if game.scorePoints < game.line.stations|length * 100 %}
                                            <a href="{{ path('ferrovipath_resume_game', {'id': game.getIdGame()}) }}"
                                               data-game-id="{{ game.getIdGame() }}"
                                               data-line-color="{{ game.line.getColor() }}"
                                               class="saved-game-link">
                                                <div class="button-visual">
                                                    <div class="savedGame-button-title" style="background-color: {{ game.line.getColor() }}">
                                                        {{ game.line.nameLine }}
                                                    </div>
                                                    <div class="savedGame-content-layout">
                                                        <div class="savedGame-center">
                                                            {{ game.completedStations|length }}/{{ game.line.stations|length }}
                                                        </div>
                                                        <div class="savedGame-time">
                                                            {{ game.time|number_format(0, '.', '') }}s
                                                        </div>
                                                    </div>
                                                </div>
                                            </a>
                                        {% endif %}
                                    {% endfor %}
                                </div>
                            {% else %}
                                <p>Aucune partie sauvegardée à reprendre.</p>
                            {% endif %}
                        </div>
                    {% else %}
                        <div class="tab-pane fade" id="savedGameTab" role="tabpanel">
                            <p>Inscrivez-vous ou connectez-vous pour jouer à des parties sauvegardées</p>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
