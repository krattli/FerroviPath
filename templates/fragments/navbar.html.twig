 <div class="modal fade" id="lineSelectionModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Choisir une ligne</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <label for="lineSelector"></label><select class="form-select" id="lineSelector">
                        <option value="" selected disabled>Sélectionnez une ligne</option>
                        {% if line_services.getLines() is empty %}
                            <option value="0" >Ligne de test</option>
                        {% endif %}
                        {% for line in line_services.getLines() %}
                            <option value="{{ line.getIdLine() }}">{{ line.getNameLine() }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="modal-footer">
                    <button
                            type="button"
                            class="btn btn-primary"
                            id="startGameBtn"
                            disabled
                    >
                        Play
                    </button>
                </div>
            </div>
        </div>
    </div>


<style>
  .navbar-nav .nav-link:hover {
    background-color: #0056b3; /* Change la couleur de fond lors du hover */
    color: white; /* Change la couleur du texte lors du hover */
    border-radius: 5px; /* Ajoute un rayon de bordure pour les coins arrondis */
  }

</style>

<script>
    // Activation du bouton Play quand une ligne est sélectionnée
    document.getElementById('lineSelector').addEventListener('change', function() {
        document.getElementById('startGameBtn').disabled = !this.value;
    });

    // Redirection vers la page du jeu avec la ligne sélectionnée
    document.getElementById('startGameBtn').addEventListener('click', function() {
        const selectedLineId = document.getElementById('lineSelector').value;
        if (selectedLineId) {
            window.location.href = `/game/${selectedLineId}`;
        }
    });
</script>