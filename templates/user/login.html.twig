{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
    {% if app.user %}
        <div class="mb-3">
            Vous êtes déjà connecté {{ app.user.userIdentifier }}, <a href="{{ path('ferrovipath_logout') }}">Deconnexion</a>
        </div>
    {% else %}
    <div class="container mt-4 d-flex flex-column align-items-center w-50">
        <div class="card-header text-center ">
            <h1 class="mb-3"> Connexion </h1>
        </div>
            
        <form method="post" class="w-100">
            <div class="card shadow-sm mb-4">
                <div class="card-body row d-flex justify-content-center text-center">
                    <div class="col-md-8">
                        <div class="mb-3 ">
                            <label for="inputEmail">Email</label>
                            <input type="email" value="{{ last_username }}" name="email" id="inputEmail" class="form-control" autocomplete="email" required >                        
                        </div>
                        <div class="mb-3">
                            <label for="inputPassword">Password</label>
                            <input type="password" name="password" id="inputPassword" class="form-control" autocomplete="current-password" required>
                        </div>
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                    </div>
                </div>
            </div>
        
            <div class="text-center">
                <button class="btn btn-primary mb-2" type="submit">Se connecter</button>
                <p>Vous n'avez pas de compte ? <a href="{{ path('ferrovipath_register') }}" class="link-primary">Inscrivez-vous</a></p>
            </div>
        </form>               
    </div>

    {% if error %}
        <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
    {% endif %}
    
    {% endif %}

{% endblock %}