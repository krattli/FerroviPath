{% extends 'base.html.twig' %}

{% block title %}{{ profil.pseudo }}{% endblock %}

{% block body %}
<div class="container mt-4 d-flex flex-column align-items-center w-100">
    <div class="card-header text-center">
        <h1 class="mb-3">Profil</h1>
    </div>
    <div class="card shadow-sm mb-4 w-50">
        <div class="card-body row d-flex justify-content-center text-center">
            <div class="col-md-10">
                <table class="table shadow-sm " border=1>
                    <tr> 
                        <th scope="col">Email : </th>
                        <td>{{ profil.email }}</td>
                    </tr>
                        
                    <tr>
                        <th scope="row">Mot de passe : </th>
                        <td>****</td>
                    </tr>
                    <tr>
                        <th scope="row"> Pseudonyme : </th>
                        <td>{{ profil.pseudo }}</td>
                    <tr>
                        <th scope="row"> Né(e) le :</th> 
                        <td>{{ profil.birth|date('Y-m-d') }}</td>
                    <tr>
                        <th scope="row"> Crée le : </th>
                        <td> {{ profil.createdAt|date('Y-m-d') }}</td>
                </table>
            </div>
        </div>
        <div class="d-flex justify-content-center gap-2 mb-3">
                {% for message in app.flashes('success') %}
                    <div class="alert alert-success text-center">
                        {{ message }}
                    </div>
                {% endfor %}
            <a href= "{{ path('ferrovipath_user_modify', {'id': profil.idUser}) }}" class="btn btn-secondary">Modifier</a>
            <a href= "{{ path('ferrovipath_user_delete', {'id': profil.idUser}) }}" class="btn btn-danger" onclick="return confirm('Etes-vous sûr de supprimer?')">Supprimer le compte</a>
        </div>
    </div>
</div>
{% endblock %}